{
  // Nur Typprüfung der JS-Dateien (JSDoc), keine Ausgabe: das Spiel läuft weiter ohne Build-Schritt.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["js/**/*.js", "types/*.d.ts"]
}
